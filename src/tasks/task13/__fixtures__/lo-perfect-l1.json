t\t<strong><font size=\"4\" style=\"font-size: 14pt\">Планета</font></strong></p>\n\t\t\t</td>\n\t\t\t<td width=\"125\" style=\"border: 1px solid #000000; padding-top: 0.05cm; padding-bottom: 0.16cm; padding-left: 0.32cm; padding-right: 0.05cm\"><p align=\"center\">\n\t\t\t\t<strong><font size=\"4\" style=\"font-size: 14pt\">Диаметр\n\t\t\t\t(км)</font></strong></p>\n\t\t\t</td>\n\t\t\t<td width=\"123\" style=\"border: 1px solid #000000; padding-top: 0.05cm; padding-bottom: 0.16cm; padding-left: 0.32cm; padding-right: 0.05cm\"><p align=\"center\">\n\t\t\t\t<strong><font size=\"4\" style=\"font-size: 14pt\">Спутники</font></strong></p>\n\t\t\t</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td width=\"81\" style=\"border: 1px solid #000000; padding-top: 0.05cm; padding-bottom: 0.16cm; padding-left: 0.32cm; padding-right: 0.05cm\"><p align=\"justify\">\n\t\t\t\t<font size=\"4\" style=\"font-size: 14pt\">Марс</font></p>\n\t\t\t</td>\n\t\t\t<td width=\"125\" style=\"border: 1px solid #000000; padding-top: 0.05cm; padding-bottom: 0.16cm; padding-left: 0.32cm; padding-right: 0.05cm\"><p align=\"center\">\n\t\t\t\t<font size=\"4\" style=\"font-size: 14pt\">6779</font></p>\n\t\t\t</td>\n\t\t\t<td width=\"123\" style=\"border: 1px solid #000000; padding-top: 0.05cm; padding-bottom: 0.16cm; padding-left: 0.32cm; padding-right: 0.05cm\"><p align=\"center\">\n\t\t\t\t<font size=\"4\" style=\"font-size: 14pt\">2</font></p>\n\t\t\t</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td width=\"81\" style=\"border: 1px solid #000000; padding-top: 0.05cm; padding-bottom: 0.16cm; padding-left: 0.32cm; padding-right: 0.05cm\"><p align=\"justify\">\n\t\t\t\t<font size=\"4\" style=\"font-size: 14pt\">Венера</font></p>\n\t\t\t</td>\n\t\t\t<td width=\"125\" style=\"border: 1px solid #000000; padding-top: 0.05cm; padding-bottom: 0.16cm; padding-left: 0.32cm; padding-right: 0.05cm\"><p align=\"center\">\n\t\t\t\t<font size=\"4\" style=\"font-size: 14pt\">12104</font></p>\n\t\t\t</td>\n\t\t\t<td width=\"123\" style=\"bord